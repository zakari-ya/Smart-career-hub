# --- Frontend (Vercel / Local) ---
# Convex deployment URL used by the React app.
VITE_CONVEX_URL=

# Convex .site URL used by the local Vite proxy for /api/auth.
VITE_CONVEX_SITE_URL=

# Convex .site URL used by the Vercel auth proxy.
CONVEX_SITE_URL=

# --- Backend (Convex Dashboard Only) ---
# Set these in Convex Dashboard -> Settings -> Environment Variables:
# - BETTER_AUTH_SECRET
# - SITE_URL
# - GOOGLE_CLIENT_ID
# - GOOGLE_CLIENT_SECRET
# - GITHUB_CLIENT_ID
# - GITHUB_CLIENT_SECRET
# - OPENROUTER_API_KEY
# - OPENROUTER_HTTP_REFERER
